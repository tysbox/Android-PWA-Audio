# Cloudflare Pages cache control
# index.html must NEVER be cached - it references hashed JS bundles
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Hashed assets are immutable - safe to cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Worklet must never be cached (DSP processor updates)
/dsp-processor.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate
